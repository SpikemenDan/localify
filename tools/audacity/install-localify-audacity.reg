Windows Registry Editor Version 5.00

; Localify -> Audacity: registers the localify-audacity: link for the CURRENT USER only (HKCU).
; No administrator rights needed. Undo with uninstall-localify-audacity.reg.
; Before importing, copy localify-audacity.ps1 to:
;   %LOCALAPPDATA%\Localify Audacity Helper\localify-audacity.ps1
;
; The command is stored as REG_EXPAND_SZ (hex(2)) so %LOCALAPPDATA% expands. Decoded, it is:
; powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "%LOCALAPPDATA%\Localify Audacity Helper\localify-audacity.ps1" "%1"

[HKEY_CURRENT_USER\Software\Classes\localify-audacity]
@="URL:Localify Open in Audacity"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\localify-audacity\shell]

[HKEY_CURRENT_USER\Software\Classes\localify-audacity\shell\open]

[HKEY_CURRENT_USER\Software\Classes\localify-audacity\shell\open\command]
@=hex(2):70,00,6f,00,77,00,65,00,72,00,73,00,68,00,65,00,6c,00,6c,00,2e,00,65,\
  00,78,00,65,00,20,00,2d,00,4e,00,6f,00,50,00,72,00,6f,00,66,00,69,00,6c,00,\
